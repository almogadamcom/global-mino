# Supabase project settings — replace the empty values locally.
# Project URL, for example: https://your-project-ref.supabase.co
SUPABASE_URL=

# Server-only credential. Never expose this in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Intended enquiry table; create it when implementing the Supabase backend.
SUPABASE_ENQUIRIES_TABLE=enquiries

# Local server
PORT=4173
